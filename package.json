{
  "name": "corex",
  "version": "2.19.0",
  "description": "CoreX",
  "main": "./out/main/index.js",
  "author": "Noveriks",
  "license": "MIT",
  "homepage": "https://github.com/Noveriks/CoreX",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lucide/lab": "^0.1.2",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-store": "8.1.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.542.0",
    "posthog-js": "^1.362.0",
    "react-router-dom": "^7.8.2",
    "react-toastify": "^11.0.5",
    "systeminformation": "^5.31.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.noveriks.corex",
    "productName": "CoreX",
    "artifactName": "CoreX-Setup.exe",
    "compression": "normal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!release{,/**}",
      "!node_modules/.ignored{,/**}",
      "!node_modules/electron-builder{,/**}",
      "!node_modules/app-builder-lib{,/**}",
      "!*.md",
      "!.git{,/**}",
      "!.pnpm-store{,/**}"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "asar": true,
    "afterSign": "scripts/hooks/sign-app.js",
    "afterAllArtifactBuild": "scripts/hooks/sign-installer.js",
    "win": {
      "icon": "resources/corex.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CoreX"
    }
  },
  "repository": "https://github.com/Noveriks/CoreX",
  "packageManager": "pnpm@10.29.3"
}
